# ═══════════════════════════════════════════════════════════════
# OpenDataCopilot - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# LLM Provider - OpenAI (Required)
# ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model selection (optional, defaults shown)
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────
# Data APIs - Pollution & Environment
# ─────────────────────────────────────────────────────────────────
# GÉOD'AIR API (France national air quality - RECOMMENDED)
# Get your key at: https://www.geodair.fr/donnees/api
# Rate limit: 15 requests/hour
GEODAIR_API_KEY=your-geodair-api-key-here

# Airparif API (Île-de-France air quality - detailed data)
# Get your key at: https://data-airparif-asso.opendata.arcgis.com/
AIRPARIF_API_KEY=your-airparif-api-key-here

# OpenAQ API (Global air quality - optional, limited France data)
# Get your key at: https://openaq.org/
OPENAQ_API_KEY=your-openaq-api-key-here

# ─────────────────────────────────────────────────────────────────
# Optional: Reranking
# ─────────────────────────────────────────────────────────────────
# Cohere API (for reranking in RAG optimized)
# Get your key at: https://cohere.ai/
# COHERE_API_KEY=your-cohere-api-key-here

# ─────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_PORT=8501

# ─────────────────────────────────────────────────────────────────
# Database Settings
# ─────────────────────────────────────────────────────────────────
# SQLite databases (relative paths from project root)
SANTE_DB_PATH=data/processed/sante.db
POLLUTION_DB_PATH=data/processed/pollution.db
METADATA_DB_PATH=data/processed/metadata.db

# ─────────────────────────────────────────────────────────────────
# Vector Store Settings
# ─────────────────────────────────────────────────────────────────
# FAISS index path (for baseline RAG)
FAISS_INDEX_PATH=data/vectorstore/faiss

# ChromaDB path (for optimized RAG)
CHROMA_PERSIST_PATH=data/vectorstore/chroma

# ─────────────────────────────────────────────────────────────────
# Cache Settings
# ─────────────────────────────────────────────────────────────────
# Enable API response caching
ENABLE_CACHE=true

# Cache directory
CACHE_DIR=.cache

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# ─────────────────────────────────────────────────────────────────
# RAG Settings
# ─────────────────────────────────────────────────────────────────
# Chunk size for text splitting
CHUNK_SIZE=1000

# Chunk overlap
CHUNK_OVERLAP=200

# Number of documents to retrieve
TOP_K=5

# ─────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────
# Max requests per minute to external APIs
MAX_REQUESTS_PER_MINUTE=60

# Delay between API calls (seconds)
API_CALL_DELAY=0.5
